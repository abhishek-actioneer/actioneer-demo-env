# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/tests/visual/snapshots/*-actual.png
/tests/visual/snapshots/*-diff.png

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (secrets stay local)
.env*
!.env.example

# data — ignore everything except sample dataset metadata
/data/*
!/data/datasets/
/data/datasets/*
!/data/datasets/quickhelp/
!/data/datasets/vastu-hfc/
!/data/datasets/healthians/
!/data/datasets/presto/
!/data/datasets/fundsindia/
!/data/datasets/hdfc-creditfraud/
!/data/datasets/yesbank-cards/
!/data/datasets/flipkart-marketplace/
!/data/datasets/suvidha-capital/
data/*.sqlite
data/*.sqlite-wal
data/*.sqlite-shm

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.worktrees/
.claude-plugin
.worktrees
adv_report.csv

# Pi coding agent
.pi/
.gstack/
*.bak

# clerk configuration (can include secrets)
/.clerk/
/playwright/.clerk/

# analysis-service local artifacts (Python env + downloaded models — never commit)
/analysis-service/.venv/
/analysis-service/pretrained_models/

# python bytecode
__pycache__/
*.pyc
