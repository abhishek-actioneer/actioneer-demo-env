# OpenAI API key (required)
OPENAI_API_KEY=your-openai-api-key

# Optional: override OpenAI model (default: gpt-5.4)
# OPENAI_MODEL=gpt-5.4
# Optional: override OpenAI image generation model (default: gpt-image-1)
# OPENAI_IMAGE_MODEL=gpt-image-1

# ── Browserbase (roleplay URL ingestion for JS tabs/accordions + page links) ──
# Optional. When set, /api/roleplay/ingest renders product URLs in a managed
# browser, opens likely tabs/accordions, and fetches relevant linked policy docs.
BROWSERBASE_API_KEY=

# Clerk Auth (https://clerk.com)
# In keyless mode, these can be omitted for quick prototyping
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── DuckDB memory limits (Railway OOM prevention) ──────────────────────────────
# Caps DuckDB's native buffer manager so it doesn't consume the entire container RAM.
# Values below are tuned for Railway Hobby (512MB container).
# For Railway Developer/Pro (1GB): set DUCKDB_MEMORY_LIMIT=400MB, NODE_OPTIONS=--max-old-space-size=512
DUCKDB_MEMORY_LIMIT=256MB
DUCKDB_THREADS=1  # 1 thread is correct for Railway Hobby (0.5 vCPU); extra threads add context-switching overhead with no throughput benefit

# Caps the Node.js V8 heap. Without this, V8 and DuckDB compete for the same physical
# memory, triggering Linux OOM kills (exit code 137) even after DuckDB limits are set.
NODE_OPTIONS=--max-old-space-size=256

# ── Vercel Blob (image uploads in the email composer) ────────────────────────
# Sign up at vercel.com/dashboard → Storage → Create → Blob. Token granted there.
# Required for inserting images into email campaigns. Without it,
# /api/assets/upload returns 503 and image insertion is disabled.
BLOB_READ_WRITE_TOKEN=

# ── PostHog (product analytics + LLM observability) ───────────────────────────
# Sign up at posthog.com → Project Settings → API key. Same key for both vars.
# Leave blank to disable. Frontend uses NEXT_PUBLIC_*; server uses POSTHOG_API_KEY.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# ── Voice E2E observability (docs/observability/voice-hogql.md) ────────────────
# Off by default. Set to 1 to emit the voice latency/quality spine to PostHog.
# When POSTHOG_API_KEY is unset, events still print as greppable
# `[voice/latency] {…}` lines (fail-open local sink) — no PostHog needed to verify.
VOICE_LATENCY_METRICS=
# Layer 2 post-call enrichment sample rate (0.0–1.0). Default 1.0 = every call.
# The deterministic spine is always every-call regardless of this knob.
VOICE_ENRICHMENT_SAMPLE_RATE=1.0

# ── Voice forensics (Modal PyTorch/CUDA inference) ────────────────────────────
# Runs user-side audio milestones: 0.5s, 1s, 2s, 5s. Missing config produces
# "unavailable" model rows rather than fake scores.
VOICE_FORENSICS_ENABLED=true
VOICE_FORENSICS_MODAL_URL=
# Optional bearer token sent by the Next/Railway caller.
# VOICE_FORENSICS_MODAL_TOKEN=
# VOICE_FORENSICS_MODAL_TIMEOUT_MS=120000

# Public callback URL for voice webhooks.
# Production can usually rely on RAILWAY_PUBLIC_DOMAIN/VERCEL_URL automatically.
# Set VOICE_PUBLIC_BASE_URL only when you need to force a custom public origin.
# Local dev can use NEXT_PUBLIC_BASE_URL=https://your-ngrok-domain.
VOICE_PUBLIC_BASE_URL=
PLIVO_STREAM_BASE_URL=
NEXT_PUBLIC_BASE_URL=

# ── Gupshup WhatsApp (post-call follow-up messages + inbound webhook) ────────
# API key from Gupshup dashboard (gupshup.io → App → Overview → API key). Used
# in "account" template API mode; omit if using GUPSHUP_WHATSAPP_PARTNER_TOKEN instead.
GUPSHUP_WHATSAPP_API_KEY=
# App ID exactly as registered in Gupshup (required to resolve inbound webhooks
# and send messages). Missing this causes "Mapped Bot Not Found".
GUPSHUP_WHATSAPP_APP_ID=
# App name exactly as registered in Gupshup (case-sensitive, optional display name).
GUPSHUP_WHATSAPP_APP_NAME=
# Your WhatsApp Business (source) number in E.164 format, e.g. 919876543210 (no leading +).
GUPSHUP_WHATSAPP_SOURCE=
# Shared secret checked on inbound POST /api/webhooks/gupshup/whatsapp. Required in
# production; placeholder OK for local dev where signature checks are relaxed.
GUPSHUP_WHATSAPP_WEBHOOK_SECRET=
# Optional: "partner" API mode instead of account API key mode.
# GUPSHUP_WHATSAPP_PARTNER_TOKEN=
# GUPSHUP_WHATSAPP_TEMPLATE_API_MODE=account
# Optional: WhatsApp template send overrides (defaults resolved per-tenant otherwise).
# GUPSHUP_WHATSAPP_TEMPLATE_ID=
# GUPSHUP_WHATSAPP_TEMPLATE_PARAMS=
# Optional: override Gupshup API base URLs (rarely needed).
# GUPSHUP_WHATSAPP_API_BASE=
# GUPSHUP_WHATSAPP_TEMPLATE_API_BASE=
# GUPSHUP_WHATSAPP_PARTNER_API_BASE=

# ── Twilio SMS (post-call SMS follow-up) ──────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Optional SMS sender override for /dev/sms. Falls back to TWILIO_PHONE_NUMBER.
TWILIO_SMS_FROM=
# Twilio SendGrid email sender. SENDGRID_* aliases are also supported.
TWILIO_SENDGRID_API_KEY=
TWILIO_SENDGRID_FROM_EMAIL=
TWILIO_SENDGRID_FROM_NAME=
TWILIO_SENDGRID_REPLY_TO=

# Voice campaign call provider:
# plivo-gemini   = our Plivo media stream + Gemini/OpenAI runtime
# rumik-pipecat  = partner-managed Plivo/Pipecat stack with dynamic context payload
VOICE_CALL_PROVIDER=plivo-gemini
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_PHONE_NUMBER=
# Optional alternative dialer shown in the Integrations catalog.
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_PHONE_NUMBER=
EXOTEL_SUBDOMAIN=api.in.exotel.com
# Zoho CRM OAuth credentials for post-call notes and follow-up tasks.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_API_DOMAIN=https://www.zohoapis.in
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.in
# openai-cartesia | gemini-live
VOICE_AGENT_PROVIDER=openai-cartesia
OPENAI_REALTIME_MODEL=gpt-realtime-mini
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Sulafat
GEMINI_LIVE_TEMPERATURE=0.55
# Optional: Gemini Live VAD tuning (all have safe code defaults, shown here).
# GEMINI_LIVE_CUSTOM_VAD=0
# GEMINI_LIVE_VAD_START=START_SENSITIVITY_MEDIUM
# GEMINI_LIVE_VAD_END=END_SENSITIVITY_MEDIUM
# GEMINI_LIVE_VAD_PREFIX_PADDING_MS=140
# GEMINI_LIVE_VAD_SILENCE_MS=450
# Client activity-open bar (~20ms/frame). Higher = harder for ambient TV to start a turn.
# Soft bar only while awaiting a language preference answer (short "Tamil"/"Hindi").
# Start at 4 if 10 drops real speech; raise to 6–8 only if ambient false replies return.
GEMINI_LIVE_ACTIVITY_START_FRAMES=4
GEMINI_LIVE_ACTIVITY_START_FRAMES_LANG_PREF=2
# After empty barge-in recovery, ignore ambient drops so the continue turn can play.
GEMINI_LIVE_BARGE_IN_RECOVERY_PROTECT_MS=3000
# Set to 0 only if call-screening detection should not request input transcripts.
VOICE_DETECT_CALL_SCREENING=1
# sarvam | cartesia
VOICE_TTS_PROVIDER=sarvam
SARVAM_API_KEY=
SARVAM_TTS_SPEAKER=priya
SARVAM_TTS_PACE=1.06
SARVAM_TTS_TEMPERATURE=0.7
# Optional: debug override for voice insights run ID (defaults to latest run).
# VOICE_INSIGHTS_RUN_ID=
CARTESIA_API_KEY=
CARTESIA_MODEL_ID=sonic-3
# Hinglish Speaking Lady from Cartesia's public voice library. Override from /api/voice/cartesia-voices?q=Hindi.
CARTESIA_VOICE_ID=95d51f79-c397-46f9-b49a-23763d3eaa2d
CARTESIA_TTS_SPEED=1
CARTESIA_TTS_EMOTION=neutral
RUMIK_PIPECAT_START_URL=https://13-207-65-124.sslip.io/start
RUMIK_PIPECAT_FROM_NUMBER=
RUMIK_PIPECAT_API_KEY=
RUMIK_PIPECAT_CALLBACK_SECRET=
# Browser WebRTC live-test endpoint for Rumik/Pipecat. Keep API key server-side only.
PIPECAT_START_URL=https://api.pipecat.daily.co/v1/public/funds-india-kyc/start
PIPECAT_API_KEY=
# Browser live-test sidecar transcription. Uses OpenAI audio transcription on
# role-separated audio streams from the local mic and remote bot Daily tracks.
VOICE_LIVE_TRANSCRIBE_MODEL=gpt-realtime-whisper
VOICE_LIVE_TRANSCRIBE_DELAY=low
# true logs a sanitized Rumik payload with masked phone numbers and prompt length.
VOICE_CALL_DEBUG_PAYLOAD=false
# Optional Railway volume mount for voice campaign JSON, MP3 recordings, and WAV bridge recordings.
# baby-sentinel Railway production mounts the persistent volume at /app/data.
OPENAI_MODEL=gpt-5.4
VOICE_STORAGE_DIR=/app/data

# ── Call recording storage (local disk vs S3) ─────────────────────────────────
# local | s3. "local" writes under VOICE_STORAGE_DIR; "s3" uploads to VOICE_RECORDING_S3_BUCKET.
VOICE_RECORDING_STORAGE_PROVIDER=local
# Optional S3 settings — only required when VOICE_RECORDING_STORAGE_PROVIDER=s3.
# Credentials are picked up by the AWS SDK default chain (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY)
# or an attached IAM role; no code changes needed either way.
# AWS_REGION=us-east-1
# AWS_DEFAULT_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# VOICE_RECORDING_S3_BUCKET=
# VOICE_RECORDING_S3_PREFIX=voice-recordings
# Fallback provider to try if the primary storage write fails (optional).
# VOICE_RECORDING_STORAGE_FALLBACK=local

# ── Fivetran call-event export (optional, disabled by default) ───────────────
# Set to 1 to enable the background dispatcher pushing call events to Fivetran.
CALL_EVENT_EXPORT_ENABLED=0
# FIVETRAN_CALL_EVENTS_ENDPOINT=
# FIVETRAN_CALL_EVENTS_API_KEY=
# FIVETRAN_CALL_EVENTS_TIMEOUT_MS=15000
# Dispatcher tuning (optional; code defaults shown).
# CALL_EVENT_DISPATCH_INTERVAL_MS=5000
# CALL_EVENT_DISPATCH_BATCH_SIZE=50
# CALL_EVENT_PROCESSING_STALE_MS=300000

# ── Post-call follow-up delivery ──────────────────────────────────────────────
# Post-call follow-ups are WhatsApp-only, always sent as an approved Gupshup
# template (a phone call does not open WhatsApp's 24h session). There is no SMS
# or Twilio path here, and no channel to configure.
# Delay before sending the post-call WhatsApp follow-up, in ms (default 30000).
VOICE_POST_CALL_FOLLOWUP_DELAY_MS=30000
# Set to 0 to stop firing the follow-up from the live transcript at call close.
# Leave unset — this is the only trigger that trails every Gemini Live call.
# VOICE_POST_CALL_FOLLOWUP_FROM_LIVE_TRANSCRIPT=0
